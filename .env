# API Configuration
# ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL  — used by Axios.ts (APIComponent/authService)
# NEXT_PUBLIC_API_BASE_URL — used by authService.ts / marketplaceService / cartService / apiClient
#   Keep this as /backend-api so requests go via the Next.js server-side proxy.
#   The browser never hits the Cloudflare/ngrok URL directly → no CORS OPTIONS preflight.
# BACKEND_ORIGIN — server-only (no NEXT_PUBLIC_ prefix). next.config.ts reads this
#   to know where to forward /backend-api/* requests. Never sent to the browser.
# ─────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=/backend-api/api/v1
NEXT_PUBLIC_API_BASE_URL=/backend-api
BACKEND_ORIGIN=https://2b11-105-127-7-75.ngrok-free.app
